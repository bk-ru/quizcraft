# Copy to `.env` and adjust for your local environment.
# Real shell environment variables always take precedence over values from this file.

# --- LM Studio ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e2b
# Separate embedding-compatible model for RAG. If omitted, LM_STUDIO_MODEL is used.
# LM_STUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# Comma-separated chat model allowlist. Defaults to LM_STUDIO_MODEL when omitted.
# LM_STUDIO_ALLOWED_MODELS=google/gemma-4-e2b,qwen2.5-7b-instruct

# --- Backend runtime ---
# Секунды ожидания backend для LM Studio. По умолчанию отключено (бесконечное ожидание).
# Установите значение, например 300, если нужен таймаут для медленных моделей.
# REQUEST_TIMEOUT=
MAX_FILE_SIZE_MB=10
MAX_DOCUMENT_CHARS=50000

# --- Logging ---
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s

# --- Generation profiles, optional JSON ---
# DEFAULT_GENERATION_PROFILE=balanced
# GENERATION_PROFILES={"balanced": {"inference_parameters": {}}}
